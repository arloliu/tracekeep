# tracekeep on a standalone host: every role in one process (architecture.md §3.3, docs/guides/standalone.md).
# Install: the binary at /usr/local/bin/tracekeep, this file under /etc/systemd/system/, tracekeep.sysusers under /usr/lib/sysusers.d/,
# the configuration at /etc/tracekeep/config.yaml, credentials under /etc/tracekeep/secrets/ (0640 root:tracekeep),
# key material under /etc/tracekeep/keys/ (0600 tracekeep). Upgrade: stop the unit, replace the binary, start it.

[Unit]
Description=tracekeep, the traffic-log service
Documentation=https://github.com/arloliu/tracekeep/blob/main/docs/guides/standalone.md
Wants=network-online.target
After=network-online.target
# Waits for a bus or a catalog that comes up later: restarts are never given up.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tracekeep
Group=tracekeep
# Migration before every start, while no role holds a SQLite catalog; it only ensures, so a start without a new release changes nothing.
ExecStartPre=/usr/local/bin/tracekeep migrate --config /etc/tracekeep/config.yaml
ExecStart=/usr/local/bin/tracekeep all --config /etc/tracekeep/config.yaml
# Bounds the migration, a held MariaDB migration lock included.
TimeoutStartSec=15min
Restart=on-failure
RestartSec=10s

# /var/lib/tracekeep: the SQLite catalog, an fs store and the work directories.
StateDirectory=tracekeep
StateDirectoryMode=0750
Environment=TRACEKEEP_INGEST_WORK_DIR=/var/lib/tracekeep/work
Environment=TRACEKEEP_EXPORTS_WORK_DIR=/var/lib/tracekeep/exports
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# The API's port is above 1024: no capability at all.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
